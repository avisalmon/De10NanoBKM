# Virtual environment - ALWAYS named `env`. (`.env` below is a different thing.)
env/
.venv/
venv/

# Secrets / local config. Never commit .env.
.env
.env.*
!.env.example

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
*.egg-info/

# Quartus build outputs: regenerated by every compile, large, and machine-specific.
# Commit the sources (.qpf .qsf .sdc .sv .v .qip .ip .qsys .mif .hex), never these.
db/
incremental_db/
output_files/
qdb/
tmp-clearbox/
greybox_tmp/
hc_output/
.qsys_edit/
hps_isw_handoff/
*.qws
*.rpt
*.summary
*.smsg
*.done
*.jdi
c5_pin_model_dump.txt
PLLJ_PLLSPE_INFO.txt
*.qdf.bak
*.qsf.bak
*.pin

# Bitstreams, wherever a build puts them. Share one as a GitHub Release, never in git.
*.sof
*.pof
*.jic
*.rbf

# Simulation outputs (scripts/fpga.py sim writes into sim_build/)
sim_build/
*.vvp
*.vcd
*.fst
*.wlf
transcript
work/

# Tool licence files are tied to one computer's network card: personal, never public
*license*.dat
*License*.dat

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/*
!.vscode/extensions.json
.idea/

# Logs / temp
*.log
*.tmp
