# One line ending for everyone. Without this, Git for Windows checks files out with CRLF, which
# breaks shell scripts on Linux (the board runs Linux) and makes generated files look 'out of date'.
* text=auto eol=lf
*.sh text eol=lf

# Bitstreams and images are binary: never diff or convert them.
*.sof binary
*.pof binary
*.rbf binary
*.jic binary
*.rpd binary
*.bin binary
*.img binary
*.dtb binary
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.gz binary
*.qar binary
